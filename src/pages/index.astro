---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

// Get the base path from the config
const base = import.meta.env.BASE_URL;

// Get latest news posts
const allPosts = await getCollection('news');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const recentPosts = sortedPosts.slice(0, 3);

// Import matches data
const matchesData = await import('../../data/matches.json');
const matches = matchesData.default.matches;

// Import schedule data for next match countdown
const scheduleData = await import('../../data/season-schedule.json');
const schedule = scheduleData.default.matches;

// Find next upcoming match
const today = new Date();
today.setHours(0, 0, 0, 0);
const nextMatch = schedule.find(m => {
  const matchDate = new Date(m.date);
  return m.status === 'scheduled' && matchDate >= today;
});

// Format next match date for display
function formatMatchDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
}

// Get opponent name (cleaned up)
function getOpponent(match: any) {
  if (match.venue === 'Home') {
    return match.away_team.replace('CMFSC ', '').replace('PCFC ', '').replace('RMSC ', '').replace('PMSC ', '').replace('AFC ', '');
  }
  return match.home_team.replace('CMFSC ', '').replace('PCFC ', '').replace('RMSC ', '').replace('PMSC ', '').replace('AFC ', '');
}

// Calculate goal scorers statistics
const goalScorers = new Map();
let totalGoals = 0;
matches.forEach(match => {
  if (match.scorers && match.scorers.length > 0) {
    match.scorers.forEach(scorer => {
      if (typeof scorer === 'string') {
        const cleanName = scorer.replace(/\s*\(.*?\)\s*/g, '').trim();
        goalScorers.set(cleanName, (goalScorers.get(cleanName) || 0) + 1);
        totalGoals += 1;
      } else if (scorer.player) {
        const goals = scorer.goals || 1;
        goalScorers.set(scorer.player, (goalScorers.get(scorer.player) || 0) + goals);
        totalGoals += goals;
      }
    });
  }
});

// Sort by goals (descending)
const sortedScorers = Array.from(goalScorers.entries())
  .sort((a, b) => b[1] - a[1]);

// Calculate assist statistics
const assistStats = new Map();
matches.forEach(match => {
  if (match.assists && match.assists.length > 0) {
    match.assists.forEach(assist => {
      if (typeof assist === 'string') {
        const cleanName = assist.replace(/\s*\(.*?\)\s*/g, '').trim();
        assistStats.set(cleanName, (assistStats.get(cleanName) || 0) + 1);
      } else if (assist.player) {
        const assists = assist.assists || 1;
        assistStats.set(assist.player, (assistStats.get(assist.player) || 0) + assists);
      }
    });
  }
});

const sortedAssists = Array.from(assistStats.entries())
  .sort((a, b) => b[1] - a[1]);

// Calculate team stats
const completedMatches = matches.filter(m => m.result && m.result !== 'pending' && m.result !== 'cancelled');
const totalMatches = completedMatches.length;
const wins = matches.filter(m => m.result && m.result.includes('win')).length;
const losses = matches.filter(m => m.result && m.result.includes('loss')).length;
const draws = matches.filter(m => m.result && m.result.includes('draw')).length;

let goalsAgainst = 0;
completedMatches.forEach(m => {
  if (m.final_score) {
    goalsAgainst += m.final_score.opponent || 0;
  }
});

// Get last 5 form
const recentMatches = [...completedMatches].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const last5 = recentMatches.slice(0, 5).map(m => {
  if (m.result.includes('win')) return 'W';
  if (m.result.includes('draw')) return 'D';
  return 'L';
}).reverse();

// Calculate clean sheet halves
const cleanSheetHalves = new Map();
matches.forEach(match => {
  if (!match.goalkeepers || match.result === 'cancelled' || match.result === 'pending') return;

  let firstHalfConceded = null;
  let secondHalfConceded = null;

  if (match.final_score && match.final_score.half_time && match.final_score.half_time !== 'TBD') {
    const halfTime = match.final_score.half_time.replace(' QPR', '');
    const htParts = halfTime.split('-').map(s => parseInt(s.trim()));
    const totalConceded = match.final_score.opponent || 0;

    if (htParts.length === 2 && !isNaN(htParts[0]) && !isNaN(htParts[1])) {
      firstHalfConceded = htParts[1];
      secondHalfConceded = totalConceded - htParts[1];
    }
  }

  if (firstHalfConceded === 0 && match.goalkeepers.first_half && match.goalkeepers.first_half !== 'TBD') {
    cleanSheetHalves.set(match.goalkeepers.first_half, (cleanSheetHalves.get(match.goalkeepers.first_half) || 0) + 1);
  }
  if (secondHalfConceded === 0 && match.goalkeepers.second_half && match.goalkeepers.second_half !== 'TBD') {
    cleanSheetHalves.set(match.goalkeepers.second_half, (cleanSheetHalves.get(match.goalkeepers.second_half) || 0) + 1);
  }
});

const totalCleanSheetHalves = Array.from(cleanSheetHalves.values()).reduce((a, b) => a + b, 0);
const sortedCleanSheetKeepers = Array.from(cleanSheetHalves.entries())
  .sort((a, b) => b[1] - a[1]);

// Calculate goalkeeper appearances
const goalkeeperStats = new Map();
matches.forEach(match => {
  if (match.goalkeepers) {
    if (match.goalkeepers.first_half && match.goalkeepers.first_half !== 'TBD') {
      goalkeeperStats.set(match.goalkeepers.first_half, (goalkeeperStats.get(match.goalkeepers.first_half) || 0) + 1);
    }
    if (match.goalkeepers.second_half && match.goalkeepers.second_half !== 'TBD') {
      goalkeeperStats.set(match.goalkeepers.second_half, (goalkeeperStats.get(match.goalkeepers.second_half) || 0) + 1);
    }
  }
});

const sortedGoalkeepers = Array.from(goalkeeperStats.entries())
  .sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Home - Queens Park Rangers U11B" description="Official website for QPR U11B youth soccer team. View match results, schedules, player stats, and team news for the 2025-2026 season.">
  <div class="home-page">
    <!-- Hero Section -->
    <header class="hero-section">
      <div class="hero-content">
        <h1>Queens Park Rangers</h1>
        <p class="team-info">U11 Boys • Coquitlam Metro-Ford SC • 2025-26</p>

        <!-- Quick Stats -->
        <div class="hero-stats">
          <div class="hero-stat">
            <span class="hero-stat-value win">{wins}</span>
            <span class="hero-stat-label">Wins</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-value">{totalGoals}</span>
            <span class="hero-stat-label">Goals</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-value">{totalCleanSheetHalves}</span>
            <span class="hero-stat-label">Clean Halves</span>
          </div>
        </div>

        <!-- Current Form -->
        {last5.length > 0 && (
          <div class="hero-form">
            <span class="form-label">Form</span>
            <div class="form-badges">
              {last5.map(result => (
                <span class={`form-badge ${result.toLowerCase()}`}>{result}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    </header>

    <!-- Next Match Card -->
    {nextMatch && (
      <section class="next-match-section">
        <a href={`${base}matches/`} class="next-match-card">
          <div class="next-match-header">NEXT MATCH</div>
          <div class="next-match-content">
            <div class="next-match-teams">
              <span class="team-qpr">QPR</span>
              <span class="vs">vs</span>
              <span class="team-opponent">{getOpponent(nextMatch)}</span>
            </div>
            <div class="next-match-details">
              <span class="match-date">{formatMatchDate(nextMatch.date)}</span>
              <span class="match-time">{nextMatch.kickoff}</span>
              <span class={`venue-badge ${nextMatch.venue.toLowerCase()}`}>{nextMatch.venue}</span>
            </div>
            <div class="next-match-location">{nextMatch.field}</div>
          </div>
          <div class="next-match-countdown" data-match-date={nextMatch.date} data-match-time={nextMatch.kickoff}></div>
        </a>
      </section>
    )}

    <div class="content-wrapper">
      <!-- Season Stats Bar -->
      <section class="stats-section">
        <h2 class="section-title">
          <span class="title-icon">📊</span>
          Season Stats
        </h2>
        <div class="stats-bar">
          <div class="stat">
            <span class="stat-value">{totalMatches}</span>
            <span class="stat-label">Played</span>
          </div>
          <div class="stat win">
            <span class="stat-value">{wins}</span>
            <span class="stat-label">Wins</span>
          </div>
          <div class="stat draw">
            <span class="stat-value">{draws}</span>
            <span class="stat-label">Draws</span>
          </div>
          <div class="stat loss">
            <span class="stat-value">{losses}</span>
            <span class="stat-label">Losses</span>
          </div>
          <div class="stat goals">
            <span class="stat-value">{totalGoals}</span>
            <span class="stat-label">Scored</span>
          </div>
          <div class="stat conceded">
            <span class="stat-value">{goalsAgainst}</span>
            <span class="stat-label">Conceded</span>
          </div>
        </div>
      </section>

      <!-- Player Stats Grid -->
      <section class="player-stats-section">
        <div class="stats-grid">
          <!-- Top Scorers -->
          <div class="stats-card">
            <h3 class="stats-card-title">
              <span class="card-icon">⚽</span>
              Top Scorers
            </h3>
            <div class="stats-list">
              {sortedScorers.map((scorer, index) => (
                <div class={`stats-row ${index < 3 ? 'top-' + (index + 1) : ''}`}>
                  <span class="rank">{index + 1}</span>
                  <span class="name">{scorer[0]}</span>
                  <span class="value">{scorer[1]}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Top Assists -->
          <div class="stats-card">
            <h3 class="stats-card-title">
              <span class="card-icon">🎯</span>
              Top Assists
            </h3>
            <div class="stats-list">
              {sortedAssists.length > 0 ? (
                sortedAssists.map((assist, index) => (
                  <div class={`stats-row ${index < 3 ? 'top-' + (index + 1) : ''}`}>
                    <span class="rank">{index + 1}</span>
                    <span class="name">{assist[0]}</span>
                    <span class="value">{assist[1]}</span>
                  </div>
                ))
              ) : (
                <div class="no-data">No assists recorded yet</div>
              )}
            </div>
          </div>

          <!-- Clean Sheet Halves -->
          <div class="stats-card">
            <h3 class="stats-card-title">
              <span class="card-icon">🛡️</span>
              Clean Sheet Halves
            </h3>
            <div class="stats-list">
              {sortedCleanSheetKeepers.map((keeper, index) => (
                <div class={`stats-row ${index < 3 ? 'top-' + (index + 1) : ''}`}>
                  <span class="rank">{index + 1}</span>
                  <span class="name">{keeper[0]}</span>
                  <span class="value">{keeper[1]}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Goalkeeper Rotation -->
          <div class="stats-card">
            <h3 class="stats-card-title">
              <span class="card-icon">🧤</span>
              Goalkeeper Rotation
            </h3>
            <div class="stats-list">
              {sortedGoalkeepers.map((gk, index) => (
                <div class={`stats-row ${index < 3 ? 'top-' + (index + 1) : ''}`}>
                  <span class="rank">{index + 1}</span>
                  <span class="name">{gk[0]}</span>
                  <span class="value">{gk[1]}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Quick Links -->
      <section class="quick-links-section">
        <h2 class="section-title">
          <span class="title-icon">🔗</span>
          Quick Links
        </h2>
        <div class="quick-links-grid">
          <a href={`${base}current-week/`} class="quick-link">
            <span class="quick-link-icon">📅</span>
            <div class="quick-link-content">
              <span class="quick-link-title">This Week</span>
              <span class="quick-link-desc">Training & lineup</span>
            </div>
            <span class="quick-link-arrow">→</span>
          </a>

          <a href={`${base}matches/`} class="quick-link">
            <span class="quick-link-icon">🏟️</span>
            <div class="quick-link-content">
              <span class="quick-link-title">Match Center</span>
              <span class="quick-link-desc">Results & fixtures</span>
            </div>
            <span class="quick-link-arrow">→</span>
          </a>

          <a href={`${base}roster/`} class="quick-link">
            <span class="quick-link-icon">👥</span>
            <div class="quick-link-content">
              <span class="quick-link-title">Team Roster</span>
              <span class="quick-link-desc">Meet the squad</span>
            </div>
            <span class="quick-link-arrow">→</span>
          </a>
        </div>
      </section>

      <!-- Latest News -->
      <section class="news-section">
        <h2 class="section-title">
          <span class="title-icon">📰</span>
          Latest News
        </h2>
        <div class="news-grid">
          {recentPosts.map(post => (
            <PostCard
              title={post.data.title}
              date={post.data.date}
              summary={post.data.summary}
              slug={post.slug}
              tags={post.data.tags}
            />
          ))}
        </div>
        <div class="news-more">
          <a href={`${base}news/`} class="view-all-link">View All News →</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home-page {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Hero Section */
  .hero-section {
    background: linear-gradient(135deg, #1976d2 0%, #42a5f5 100%);
    color: white;
    padding: var(--spacing-xl) var(--spacing-md);
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .hero-content h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: var(--spacing-xs);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  .team-info {
    opacity: 0.9;
    font-size: 0.9rem;
    margin-bottom: var(--spacing-md);
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-stat-value {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
  }

  .hero-stat-value.win {
    color: #a5d6a7;
  }

  .hero-stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
  }

  .hero-form {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    background: rgba(255, 255, 255, 0.15);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: 20px;
  }

  .form-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .form-badges {
    display: flex;
    gap: 4px;
  }

  .form-badge {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.7rem;
  }

  .form-badge.w { background: #2ecc71; color: white; }
  .form-badge.d { background: #9b59b6; color: white; }
  .form-badge.l { background: #e74c3c; color: white; }

  /* Next Match Section */
  .next-match-section {
    padding: 0 var(--spacing-md);
    margin-top: calc(var(--spacing-xl) * -1);
    margin-bottom: var(--spacing-lg);
  }

  .next-match-card {
    display: block;
    background: white;
    border-radius: 12px;
    padding: var(--spacing-md) var(--spacing-lg);
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .next-match-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2);
  }

  .next-match-header {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin-bottom: var(--spacing-xs);
    text-align: center;
  }

  .next-match-content {
    text-align: center;
  }

  .next-match-teams {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }

  .team-qpr {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .vs {
    color: var(--color-text-light);
    font-size: 0.9rem;
  }

  .team-opponent {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .next-match-details {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .match-date {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .match-time {
    color: var(--color-text-light);
    font-size: 0.9rem;
  }

  .venue-badge {
    padding: 2px 10px;
    border-radius: 10px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .venue-badge.home {
    background: #d4edda;
    color: #155724;
  }

  .venue-badge.away {
    background: #e3f2fd;
    color: #1565c0;
  }

  .next-match-location {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .next-match-countdown {
    display: flex;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-sm);
    padding-top: var(--spacing-sm);
    border-top: 1px solid #eee;
  }

  .countdown-item {
    text-align: center;
    min-width: 50px;
  }

  .countdown-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .countdown-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    color: var(--color-text-light);
  }

  /* Content Wrapper */
  .content-wrapper {
    padding: 0 var(--spacing-md);
  }

  /* Section Title */
  .section-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: var(--spacing-md);
    color: var(--color-text);
  }

  .title-icon {
    font-size: 1.1rem;
  }

  /* Stats Section */
  .stats-section {
    margin-bottom: var(--spacing-lg);
  }

  .stats-bar {
    display: flex;
    justify-content: space-between;
    background: white;
    border-radius: 12px;
    padding: var(--spacing-sm) var(--spacing-md);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    overflow-x: auto;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 50px;
    padding: 0 var(--spacing-xs);
  }

  .stat-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat.win .stat-value { color: #2ecc71; }
  .stat.draw .stat-value { color: #9b59b6; }
  .stat.loss .stat-value { color: #e74c3c; }
  .stat.goals .stat-value { color: #f39c12; }
  .stat.conceded .stat-value { color: #95a5a6; }

  .stat-label {
    font-size: 0.65rem;
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Player Stats Grid */
  .player-stats-section {
    margin-bottom: var(--spacing-lg);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-md);
  }

  .stats-card {
    background: white;
    border-radius: 12px;
    padding: var(--spacing-md);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .stats-card-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid #eee;
  }

  .card-icon {
    font-size: 1rem;
  }

  .stats-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stats-row {
    display: flex;
    align-items: center;
    padding: 6px 8px;
    border-radius: 6px;
    transition: background 0.2s;
  }

  .stats-row:hover {
    background: #f8f9fa;
  }

  .stats-row.top-1 {
    background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  }

  .stats-row.top-2 {
    background: linear-gradient(135deg, #e8e8e8 0%, #f5f5f5 100%);
  }

  .stats-row.top-3 {
    background: linear-gradient(135deg, #e5a572 0%, #f0c9a6 100%);
  }

  .stats-row .rank {
    width: 24px;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-primary);
  }

  .stats-row.top-1 .rank,
  .stats-row.top-2 .rank,
  .stats-row.top-3 .rank {
    color: #333;
  }

  .stats-row .name {
    flex: 1;
    font-size: 0.9rem;
  }

  .stats-row .value {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary);
  }

  .stats-row.top-1 .value,
  .stats-row.top-2 .value,
  .stats-row.top-3 .value {
    color: #333;
  }

  .no-data {
    color: var(--color-text-light);
    font-size: 0.85rem;
    text-align: center;
    padding: var(--spacing-sm);
  }

  /* Quick Links */
  .quick-links-section {
    margin-bottom: var(--spacing-lg);
  }

  .quick-links-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    background: white;
    border-radius: 10px;
